# --- Database (required in production) ---------------------------------------
# Any PostgreSQL connection string: Supabase, Neon, Netlify DB, a VPS...
# Use the "pooled"/transaction connection string if your provider offers one.
DATABASE_URL=
# On Netlify, NETLIFY_DB_URL (Netlify Database) is used automatically when DATABASE_URL is empty.

# --- First administrator -----------------------------------------------------
# Used only when the admin_users table is empty (first start). Afterwards you can
# remove ADMIN_PASSWORD from the environment.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Public address of the site (canonical URLs, sitemap, Open Graph) --------
NEXT_PUBLIC_SITE_URL=https://www.il-tuo-dominio.it

# --- Optional e-mails through Resend (https://resend.com) --------------------
# Nothing is sent, and nothing breaks, until these are set. Admin > Email shows the state
# and has a "send a test" button. Writing to customers needs a domain verified on Resend;
# with the shared test sender (onboarding@resend.dev) only the Resend account's own address works.
RESEND_API_KEY=
MAIL_FROM="Duca d'Este <prenotazioni@il-tuo-dominio.it>"
# Where the pastry shop is told about new bookings, cake orders and requests
# (also the Reply-To of the customer e-mails).
NOTIFY_EMAIL_TO=
